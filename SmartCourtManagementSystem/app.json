{
  "expo": {
    "name": "Smart Court Management System",
    "slug": "smart-court-management-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "smartcourt",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "chervalier.marc.infinitypadel"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1D"
      },
      "package": "chervalier.marc.infinitypadel"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a79be3a0-7783-4ac1-86b7-d1732d4fe6db"
      }
    },
    "owner": "huutri222s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a79be3a0-7783-4ac1-86b7-d1732d4fe6db"
    }
  }
}
